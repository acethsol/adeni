{
  "name": "adeni",
  "private": true,
  "workspaces": [
    "apps/customer",
    "apps/business",
    "apps/admin",
    "packages/*"
  ],
  "scripts": {
    "sync:brand": "node scripts/sync-brand-assets.mjs",
    "generate:brand-favicons": "node scripts/generate-brand-favicons.mjs",
    "postinstall": "node scripts/sync-brand-assets.mjs && node scripts/strip-nested-ui-angular.mjs",
    "dev:business": "npm run dev --workspace @adeni/business",
    "dev:admin": "npm run dev --workspace @adeni/admin",
    "dev:customer": "npm run dev --workspace @adeni/customer",
    "build:admin": "npm run build --workspace @adeni/admin",
    "build:customer": "npm run build --workspace @adeni/customer",
    "build:business": "npm run build --workspace @adeni/business",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "body-parser": "2.4.0",
    "zod": "4.6.7",
    "rxjs": "7.8.2",
    "@angular/build": "22.2.2",
    "@angular/cdk": "22.2.2",
    "@angular/cli": "22.2.2",
    "@angular/common": "22.2.2",
    "@angular/compiler": "22.2.2",
    "@angular/compiler-cli": "22.2.2",
    "@angular/core": "22.2.2",
    "@angular/forms": "22.2.2",
    "@angular/platform-browser": "22.2.2",
    "@angular/platform-browser-dynamic": "22.2.2",
    "@angular/platform-server": "22.2.2",
    "@angular/router": "22.2.2",
    "@angular/ssr": "22.2.2",
    "@angular-devkit/build-angular": "22.2.2"
  },
  "devDependencies": {
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5"
  }
}
