{
  "name": "adeni",
  "private": true,
  "workspaces": [
    "apps/discover",
    "apps/portal",
    "apps/admin",
    "packages/*"
  ],
  "scripts": {
    "dev:portal": "npm run dev --workspace @adeni/portal",
    "dev:admin": "npm run dev --workspace @adeni/admin",
    "dev:discover": "npm run dev --workspace @adeni/discover",
    "build:admin": "npm run build --workspace @adeni/admin",
    "build:discover": "npm run build --workspace @adeni/discover",
    "build:portal": "npm run build --workspace @adeni/portal",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "rxjs": "7.8.2"
  }
}
