{
  "_comment": "Production template — set secrets via environment variables or Azure Key Vault (see docs/auth0-setup.md).",
  "ConnectionStrings": {
    "AdeniDb": ""
  },
  "Redis": {
    "ConnectionString": ""
  },
  "Auth0": {
    "Enabled": true,
    "Domain": "your-tenant.auth0.com",
    "Audience": "https://api.adeni.io",
    "RequireMfaForAdmin": true
  },
  "Cors": {
    "AllowedOrigins": [
      "https://app.adeni.io"
    ]
  },
  "Observability": {
    "Enabled": true,
    "ServiceName": "adeni-api",
    "ConnectionString": ""
  },
  "Market": {
    "DefaultTimeZoneId": "Africa/Lagos"
  },
  "Payments": {
    "Provider": "Paystack",
    "StubCheckoutBaseUrl": "/checkout/stub",
    "ReceiptBaseUrl": "/checkout/receipt"
  },
  "Paystack": {
    "SecretKey": "",
    "PublicKey": "",
    "WebhookSecret": "",
    "BaseUrl": "https://api.paystack.co"
  },
  "Storage": {
    "Provider": "AzureBlob",
    "AzureBlob": {
      "ConnectionString": "",
      "PublicContainer": "media",
      "PublicBaseUrl": ""
    }
  },
  "Translation": {
    "Endpoint": "https://api.cognitive.microsofttranslator.com",
    "Key": "",
    "Region": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
