/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "isolatedModules": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",
    "baseUrl": "./",
    "paths": {
      "@adeni/api-client": ["../../packages/api-client/src/index.ts"],
      "@adeni/shared": ["../../packages/shared/src/index.ts"],
      "@adeni/shared/customer-segments": ["../../packages/shared/src/customer-segments.ts"],
      "@adeni/shared/customer-insights-copy": ["../../packages/shared/src/customer-insights-copy.ts"],
      "@adeni/shared/calendar": ["../../packages/shared/src/calendar.ts"],
      "@adeni/shared/calendar-copy": ["../../packages/shared/src/calendar-copy.ts"],
      "@adeni/ui": ["../../packages/ui/src/index.ts"],
      "@adeni/brand": ["../../packages/brand/src/index.ts"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  }
}
