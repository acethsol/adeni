{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "@adeni/brand": ["../brand/src/index.ts"],
      "@adeni/shared": ["../shared/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
